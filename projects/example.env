# Copy to projects/<repo-folder-name-lowercase>.env, e.g. projects/lykos.env
# Shell syntax. This file holds a secret: it never leaves this folder.

# Required: this project's OmniRoute key (dashboard > Endpoints)
OMNIROUTE_API_KEY=

# Model used when run is called without --model. Names come from: delegate.sh models <repo>
DEFAULT_MODEL=

# Optional overrides (defaults shown)
# OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1   # as seen from inside the container
# OMNIROUTE_HOST_URL=http://localhost:20128/v1              # as seen from this machine
# SETUP_CMD="npm ci --no-audit --no-fund"                   # default when package-lock.json exists
# TEST_CMD="npm test"
# TIMEOUT_MIN=60
# MEMORY=8g

# Toolchain: projects/<repo>.Dockerfile (copy projects/example.Dockerfile), then: delegate.sh build <repo>
# IMAGE=agent-box-<repo>:latest                             # set automatically when that Dockerfile exists
# CACHES="go:/home/node/go cargo:/home/node/.cargo/registry" # named volumes kept across runs; npm is always on
# CONTAINER_ENV="GOFLAGS CGO_ENABLED"                       # names of settings in this file passed into the container

# Checks, for stacks the defaults do not cover. Regexes in single quotes.
# FAIL_REGEX='^FAIL: (\S+)'          # failing test names; one capture group per runner. Default: node:test, TAP,
#                                    # Go, cargo, GoogleTest, pytest, Gradle/JUnit (lib/verify.mjs FAIL_REGEX)
# NEIGHBOUR_SOURCES='\.(go|rs)$'      # changed files whose neighbouring tests rerun every review round
# SENSITIVE_EXTRA='^(proto|schema)/'  # more paths flagged SENSITIVE when a worker edits them
# SYNTAX_go='gofmt -e {file} >/dev/null'   # fast check after every edit, per extension; wins over the built-in
# SYNTAX_rs='rustfmt --edition 2021 --emit stdout {file} >/dev/null'

# Any other agent-box.conf setting can be overridden here for this project only: roles, loop limits,
# review roles. Check with: delegate.sh config <repo>, delegate.sh roles <repo>
# ROLE_review_std="cursor/kimi-k3-high"
# REVIEW_MODE=both                    # one reviewer for both axes (review-both); split = two reviewers
# REVIEW_ROLES="review-spec"          # or name the reviewers outright (wins over REVIEW_MODE)
# TICKET_ESCALATE_ROLE="implement-hard"
# LOOP_MAX_ROUNDS=3

# Host-side limits and lookups.
# REPO_PATH=/c/Workspace/Projects/MyRepo   # lets commands take the bare name (delegate.sh doctor myrepo)
# PROJECT_SLOTS=1                          # at most N of this project's containers at once (checks, base suites
#                                          # included); others wait. 1: a serial Gradle cache, one live server
# SLOT_PREFER_WAIT=0                       # seconds a run waits for its own slot (parked container) before taking another
# SETUP_RETRIES=0                          # 0: no second try of a failed SETUP_CMD (default 1, for network blips)
# NODE_MODULES_CACHE=0                     # with the default `npm ci`: no node_modules volume per slot (reinstall every run)
# AUTO_GC=0                                # no daily `gc --yes` of runs/ at launch (also in agent-box.local.conf, for all projects)
