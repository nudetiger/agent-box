# Copy to projects/<repo-folder-name-lowercase>.env, e.g. projects/lykos.env
# Shell syntax. This file holds a secret: it never leaves this folder.

# Required: this project's OmniRoute key (dashboard > Endpoints)
OMNIROUTE_API_KEY=

# Model used when run is called without --model. Names come from: delegate.sh models <repo>
DEFAULT_MODEL=

# Optional overrides (defaults shown)
# OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1   # as seen from inside the container
# OMNIROUTE_HOST_URL=http://localhost:20128/v1              # as seen from this machine
# SETUP_CMD="npm ci --no-audit --no-fund"                   # default when package-lock.json exists
# TEST_CMD="npm test"
# TIMEOUT_MIN=60
# MEMORY=8g
