+
+    @Test
+    void falseHidesTheLootAndAShowFalseMapKeepsItsIcon() {
+        ConfigSnapshot snapshot = load("wiki: false\n", """
+                wiki:
+                  show: false
+                  icon:
+                    id: emerald
+                """);
+
+        assertEquals(false, snapshot.wiki("off").orElseThrow().show());
