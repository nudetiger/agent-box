+    private void use(ConfigSnapshot snapshot) {
+        config = snapshot;
+        ItemSourceRegistry items = ItemSourceRegistry.create();
+        MenuRenderer renderer = new MenuRenderer(items, key -> config.message("", key), MenuWarnings.ignore);
