+  # warns high and takes the slot out.
+  content_slots:
+    - "0-44"
+  # filler: the item in every slot that is neither content nor a button.
+  filler:
+    id: gray_stained_glass_pane
+  # previous_page and next_page page the loots.
+  buttons:
+    previous_page:
+      slot: 45
+      item:
+        id: arrow
+      sound:
+        key: minecraft:ui.button.click
+    next_page:
+      slot: 53
+      item:
+        id: arrow
+      sound:
+        key: minecraft:ui.button.click
+loot:
+  rows: 6
+  content_slots:
+    - "0-44"
+  filler:
+    id: gray_stained_glass_pane
