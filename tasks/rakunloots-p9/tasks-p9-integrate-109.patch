@@ -0,0 +1,51 @@
+package me.rakkoon69.rakunloots.menu;
+
+import me.rakkoon69.rakunloots.server.MenuHolder;
+import org.bukkit.event.EventHandler;
+import org.bukkit.event.EventPriority;
+import org.bukkit.event.Listener;
+import org.bukkit.event.inventory.InventoryClickEvent;
+import org.bukkit.event.inventory.InventoryCloseEvent;
+import org.bukkit.event.inventory.InventoryDragEvent;
+import org.bukkit.inventory.Inventory;
+
+import java.util.Objects;
+
+/**
+ * Claims every click and drag in a menu, and tells the service when a menu closes.
+ */
+public final class MenuListener implements Listener {
+
+    private final MenuService menus;
+
+    public MenuListener(MenuService menus) {
+        this.menus = Objects.requireNonNull(menus, "menus");
+    }
+
+    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = false)
+    public void onClick(InventoryClickEvent event) {
+        Inventory top = event.getView().getTopInventory();
+        if (!(top.getHolder() instanceof MenuHolder)) {
+            return;
+        }
+        event.setCancelled(true);
+        int slot = event.getRawSlot();
+        if (slot >= 0 && slot < top.getSize()) {
+            menus.clickLater(event.getWhoClicked().getUniqueId(), slot);
+        }
+    }
+
+    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = false)
+    public void onDrag(InventoryDragEvent event) {
+        if (event.getView().getTopInventory().getHolder() instanceof MenuHolder) {
+            event.setCancelled(true);
+        }
+    }
+
+    @EventHandler(priority = EventPriority.HIGHEST)
+    public void onClose(InventoryCloseEvent event) {
+        if (event.getInventory().getHolder() instanceof MenuHolder holder) {
+            menus.closed(event.getPlayer().getUniqueId(), holder.menuHandle());
+        }
+    }
+}
diff --git a/src/main/java/me/rakkoon69/rakunloots/menu/MenuRenderer.java b/src/main/java/me/rakkoon69/rakunloots/menu/MenuRenderer.java
new file mode 100644
index 0000000..e27204a
--- /dev/null
+++ b/src/main/java/me/rakkoon69/rakunloots/menu/MenuRenderer.java
@@ -0,0 +1,195 @@
+package me.rakkoon69.rakunloots.menu;
+
+import me.rakkoon69.rakunloots.config.MenuButton;
+import me.rakkoon69.rakunloots.config.MenuPage;
+import me.rakkoon69.rakunloots.config.MenuSound;
+import me.rakkoon69.rakunloots.items.ItemReference;
+import me.rakkoon69.rakunloots.items.ItemResolveResult;
+import me.rakkoon69.rakunloots.items.ItemSourceRegistry;
+import me.rakkoon69.rakunloots.lootbox.MessageText;
+import org.bukkit.ChatColor;
+import org.bukkit.Material;
+import org.bukkit.inventory.ItemStack;
+import org.bukkit.inventory.meta.ItemMeta;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.Set;
+import java.util.function.Function;
+import java.util.function.IntConsumer;
+
+/**
+ * Turns one page of a menu file and its entries into a {@link MenuView}. Layout items resolve through the item
+ * sources; a miss draws a barrier and warns once for that menu entry until the next reload.
+ */
+public final class MenuRenderer {
+
+    private static final String PREVIOUS = "previous_page";
+    private static final String NEXT = "next_page";
+
+    private final ItemSourceRegistry items;
+    private final Function<String, String> language;
+    private final MenuWarnings warnings;
+    private final Set<String> warned = new HashSet<>();
+
+    public MenuRenderer(ItemSourceRegistry items, Function<String, String> language, MenuWarnings warnings) {
+        this.items = Objects.requireNonNull(items, "items");
+        this.language = Objects.requireNonNull(language, "language");
+        this.warnings = Objects.requireNonNull(warnings, "warnings");
+    }
+
+    public int pageCount(MenuPage layout, int entryCount) {
+        Objects.requireNonNull(layout, "layout");
+        if (entryCount < 0) {
+            throw new IllegalArgumentException("entryCount must not be negative");
+        }
+        int slots = layout.contentSlots().size();
+        if (entryCount == 0 || slots == 0) {
+            return 1;
+        }
+        return (entryCount + slots - 1) / slots;
+    }
+
+    public int clampPage(MenuPage layout, int entryCount, int requestedPage) {
+        int pages = pageCount(layout, entryCount);
+        return requestedPage < 0 || requestedPage >= pages ? pages - 1 : requestedPage;
+    }
+
+    public MenuView render(String menuId, String title, MenuPage layout, List<MenuIcon> entries, int requestedPage,
+                           IntConsumer goToPage) {
+        Objects.requireNonNull(menuId, "menuId");
+        Objects.requireNonNull(title, "title");
+        Objects.requireNonNull(layout, "layout");
+        Objects.requireNonNull(entries, "entries");
+        Objects.requireNonNull(goToPage, "goToPage");
+        List<MenuIcon> pageEntries = List.copyOf(entries);
+        pageEntries.forEach(entry -> Objects.requireNonNull(entry, "entry"));
+
+        int pages = pageCount(layout, pageEntries.size());
+        int page = clampPage(layout, pageEntries.size(), requestedPage);
+        MenuIcon filler = icon(menuId, "filler", layout.filler(), Optional.empty(), Optional.empty(), null, null,
+                pages, page);
+        Map<Integer, MenuIcon> icons = new LinkedHashMap<>();
+        for (int slot = 0; slot < layout.rows() * 9; slot++) {
+            icons.put(slot, filler);
+        }
+
+        List<Integer> contentSlots = layout.contentSlots();
+        contentSlots.forEach(icons::remove);
+        int first = page * contentSlots.size();
+        for (int index = 0; index < contentSlots.size(); index++) {
+            int entry = first + index;
+            if (entry >= pageEntries.size()) {
+                break;
+            }
+            icons.put(contentSlots.get(index), pageEntries.get(entry));
+        }
+
+        for (Map.Entry<String, MenuButton> button : layout.buttons().entrySet()) {
+            String name = button.getKey();
+            MenuButton value = button.getValue();
+            PageTarget target = target(name, page, pages);
+            if (target.hidden()) {
+                continue;
+            }
+            Optional<Runnable> action = target.page()
+                    .map(destination -> (Runnable) () -> goToPage.accept(destination));
+            String keyBase = switch (name) {
+                case PREVIOUS -> "menu_button_previous_page";
+                case NEXT -> "menu_button_next_page";
+                default -> null;
+            };
+            String displayName = keyBase == null ? null : pageText(keyBase + "_name", target.page().orElse(page), pages);
+            List<String> lore = keyBase == null ? null : pageLore(keyBase + "_lore", target.page().orElse(page), pages);
+            icons.put(value.slot(), icon(menuId, "button:" + name, value.item(), action, value.sound(),
+                    displayName, lore, pages, page));
+        }
+
+        return new MenuView(MessageText.color(title), layout.rows(), icons);
+    }
+
+    public synchronized void resetWarnings() {
+        warned.clear();
+    }
+
+    private record PageTarget(boolean hidden, Optional<Integer> page) {
+    }
+
+    private static PageTarget target(String name, int page, int pages) {
+        return switch (name) {
+            case PREVIOUS -> page > 0 ? new PageTarget(false, Optional.of(page - 1)) : new PageTarget(true, Optional.empty());
+            case NEXT -> page < pages - 1 ? new PageTarget(false, Optional.of(page + 1)) : new PageTarget(true, Optional.empty());
+            default -> new PageTarget(false, Optional.empty());
+        };
+    }
+
+    private MenuIcon icon(String menuId, String entry, ItemReference reference, Optional<Runnable> action,
+                          Optional<MenuSound> sound, String displayName, List<String> lore, int pages, int page) {
+        ItemResolveResult resolved = items.resolve(reference);
+        if (resolved.isMiss()) {
+            warnOnce(menuId, entry, reference);
+            ItemStack barrier = new ItemStack(Material.BARRIER);
+            ItemMeta meta = barrier.getItemMeta();
+            if (meta != null) {
+                meta.setDisplayName(ChatColor.RED + "Missing " + nameOf(reference));
+                meta.setLore(List.of(ChatColor.GRAY + "This menu item could not be loaded."));
+                barrier.setItemMeta(meta);
+            }
+            return new MenuIcon(barrier, action, sound);
+        }
+        ItemStack item = resolved.item().orElseThrow().clone();
+        if (displayName != null || lore != null) {
+            applyText(item, displayName, lore);
+        }
+        return new MenuIcon(item, action, sound);
+    }
+
+    private static void applyText(ItemStack item, String displayName, List<String> lore) {
+        ItemMeta meta = item.getItemMeta();
+        if (meta == null) {
+            return;
+        }
+        if (displayName != null) {
+            meta.setDisplayName(displayName);
+        }
+        if (lore != null) {
+            meta.setLore(lore);
+        }
+        item.setItemMeta(meta);
+    }
+
+    private String pageText(String key, int page, int pages) {
+        return MessageText.color(placeholders(language.apply(key), page, pages));
+    }
+
+    private List<String> pageLore(String key, int page, int pages) {
+        String text = pageText(key, page, pages);
+        List<String> lines = new ArrayList<>(List.of(text.split("\n", -1)));
+        return lines;
+    }
+
+    private static String placeholders(String text, int page, int pages) {
+        return text.replace("{page}", Integer.toString(page + 1)).replace("{pages}", Integer.toString(pages));
+    }
+
+    private void warnOnce(String menuId, String entry, ItemReference reference) {
+        String key = menuId + "\u0000" + entry;
+        synchronized (this) {
+            if (!warned.add(key)) {
+                return;
+            }
+        }
+        warnings.warn(MenuWarning.layoutItemMissing(menuId, entry, reference));
+    }
+
+    private static String nameOf(ItemReference reference) {
+        String source = reference.source();
+        String id = reference.id();
+        return source == null || source.isBlank() ? id : source + ":" + id;
+    }
+}
diff --git a/src/main/java/me/rakkoon69/rakunloots/menu/MenuService.java b/src/main/java/me/rakkoon69/rakunloots/menu/MenuService.java
new file mode 100644
index 0000000..c00e9d8
--- /dev/null
+++ b/src/main/java/me/rakkoon69/rakunloots/menu/MenuService.java
@@ -0,0 +1,266 @@
+package me.rakkoon69.rakunloots.menu;
+
+import me.rakkoon69.rakunloots.config.ConfigSnapshot;
+import me.rakkoon69.rakunloots.config.MenuSound;
+import me.rakkoon69.rakunloots.server.MenuHandle;
+import me.rakkoon69.rakunloots.server.ServerAdapter;
+import org.bukkit.inventory.ItemStack;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+
+/**
+ * The one owner of the menus a player has open. It tracks the handle each menu was opened as, so a close event for an
+ * old menu cannot retire its replacement, and retires an open that lands after its menu was closed or replaced.
+ */
+public final class MenuService {
+
+    private record Entry(MenuHandle handle, MenuView view) {
+    }
+
+    private static final class OpenAttempt {
+        private final MenuHandle old;
+        private final long epoch;
+        private final long generation;
+        private boolean oldClosed;
+
+        private OpenAttempt(MenuHandle old, long epoch, long generation) {
+            this.old = old;
+            this.epoch = epoch;
+            this.generation = generation;
+        }
+    }
+
+    private final ServerAdapter adapter;
+    private final MenuRenderer renderer;
+    private final Object lock = new Object();
+    private final Map<UUID, Entry> entries = new HashMap<>();
+    private final Map<UUID, OpenAttempt> openings = new HashMap<>();
+    private final Map<UUID, Long> epochs = new HashMap<>();
+    private long generation;
+
+    public MenuService(ServerAdapter adapter) {
+        this(adapter, null);
+    }
+
+    public MenuService(ServerAdapter adapter, MenuRenderer renderer) {
+        this.adapter = Objects.requireNonNull(adapter, "adapter");
+        this.renderer = renderer;
+    }
+
+    public CompletableFuture<Void> open(UUID playerId, MenuView view) {
+        Objects.requireNonNull(playerId, "playerId");
+        Objects.requireNonNull(view, "view");
+        Map<Integer, ItemStack> contents = contents(view);
+        OpenAttempt attempt;
+        MenuHandle made;
+        synchronized (lock) {
+            Entry current = entries.get(playerId);
+            attempt = new OpenAttempt(current == null ? null : current.handle(), epochs.getOrDefault(playerId, 0L),
+                    generation);
+            openings.put(playerId, attempt);
+        }
+        try {
+            made = adapter.createMenu(playerId, view.title(), view.size(), contents);
+        } catch (RuntimeException failure) {
+            forget(playerId, attempt);
+            return CompletableFuture.failedFuture(failure);
+        }
+        return adapter.openMenu(playerId, made)
+                .handle((opened, failure) -> new Opened(opened, failure))
+                .thenCompose(opened -> {
+                    if (opened.failure() != null) {
+                        forget(playerId, attempt);
+                        return CompletableFuture.failedFuture(unwrap(opened.failure()));
+                    }
+                    if (opened.handle().isEmpty()) {
+                        forget(playerId, attempt);
+                        return CompletableFuture.completedFuture(null);
+                    }
+                    return land(playerId, view, attempt, opened.handle().orElseThrow());
+                });
+    }
+
+    private record Opened(Optional<MenuHandle> handle, Throwable failure) {
+    }
+
+    private CompletableFuture<Void> land(UUID playerId, MenuView view, OpenAttempt attempt, MenuHandle next) {
+        boolean installed;
+        synchronized (lock) {
+            Entry current = entries.get(playerId);
+            boolean sameOld = current == null ? attempt.old == null : current.handle() == attempt.old;
+            installed = openings.get(playerId) == attempt
+                    && attempt.generation == generation
+                    && attempt.epoch == epochs.getOrDefault(playerId, 0L)
+                    && sameOld;
+            if (installed) {
+                openings.remove(playerId);
+                entries.put(playerId, new Entry(next, view));
+                epochs.merge(playerId, 1L, Long::sum);
+            }
+        }
+        MenuHandle close = !installed ? next : attempt.old;
+        return close(close);
+    }
+
+    private void forget(UUID playerId, OpenAttempt attempt) {
+        synchronized (lock) {
+            if (openings.get(playerId) == attempt) {
+                openings.remove(playerId);
+            }
+            Entry current = entries.get(playerId);
+            if (attempt.oldClosed && current != null && current.handle() == attempt.old) {
+                entries.remove(playerId);
+                epochs.merge(playerId, 1L, Long::sum);
+            }
+        }
+    }
+
+    public CompletableFuture<Void> refresh(UUID playerId, MenuView view) {
+        Objects.requireNonNull(playerId, "playerId");
+        Objects.requireNonNull(view, "view");
+        Entry current;
+        synchronized (lock) {
+            current = entries.get(playerId);
+            if (current == null) {
+                return CompletableFuture.completedFuture(null);
+            }
+            entries.put(playerId, new Entry(current.handle(), view));
+        }
+        return adapter.updateMenu(current.handle(), contents(view));
+    }
+
+    public CompletableFuture<Void> click(UUID playerId, int slot) {
+        return click(playerId, slot, null);
+    }
+
+    /**
+     * Runs a click on the player's thread on the next tick. The menu it was for is captured now, so a click that
+     * arrives after its menu was replaced or closed does nothing.
+     */
+    public CompletableFuture<Void> clickLater(UUID playerId, int slot) {
+        Objects.requireNonNull(playerId, "playerId");
+        MenuHandle expected;
+        synchronized (lock) {
+            Entry current = entries.get(playerId);
+            if (current == null) {
+                return CompletableFuture.completedFuture(null);
+            }
+            expected = current.handle();
+        }
+        return adapter.runOnPlayerNextTick(playerId, () -> click(playerId, slot, expected));
+    }
+
+    private CompletableFuture<Void> click(UUID playerId, int slot, MenuHandle expected) {
+        Objects.requireNonNull(playerId, "playerId");
+        Entry current;
+        synchronized (lock) {
+            current = entries.get(playerId);
+            if (current != null && expected != null && current.handle() != expected) {
+                current = null;
+            }
+        }
+        if (current == null || slot < 0 || slot >= current.view().size()) {
+            return CompletableFuture.completedFuture(null);
+        }
+        MenuIcon icon = current.view().icons().get(slot);
+        if (icon == null || icon.action().isEmpty()) {
+            return CompletableFuture.completedFuture(null);
+        }
+        try {
+            icon.action().orElseThrow().run();
+        } catch (RuntimeException failure) {
+            return CompletableFuture.failedFuture(failure);
+        }
+        Optional<MenuSound> sound = icon.sound();
+        if (sound.isEmpty()) {
+            return CompletableFuture.completedFuture(null);
+        }
+        MenuSound played = sound.get();
+        return adapter.playSound(playerId, played.key(), played.volume(), played.pitch()).thenApply(heard -> null);
+    }
+
+    public void closed(UUID playerId, MenuHandle menu) {
+        Objects.requireNonNull(playerId, "playerId");
+        Objects.requireNonNull(menu, "menu");
+        synchronized (lock) {
+            Entry current = entries.get(playerId);
+            if (current == null || current.handle() != menu) {
+                return;
+            }
+            OpenAttempt opening = openings.get(playerId);
+            if (opening != null && opening.old == menu) {
+                opening.oldClosed = true;
+                return;
+            }
+            entries.remove(playerId);
+            epochs.merge(playerId, 1L, Long::sum);
+        }
+    }
+
+    /**
+     * Closes one player's menu and cancels any open still waiting to be shown. Other players keep theirs.
+     */
+    public CompletableFuture<Void> close(UUID playerId) {
+        Objects.requireNonNull(playerId, "playerId");
+        Entry current;
+        OpenAttempt opening;
+        synchronized (lock) {
+            current = entries.remove(playerId);
+            opening = openings.remove(playerId);
+            epochs.merge(playerId, 1L, Long::sum);
+        }
+        MenuHandle menu = current != null ? current.handle() : opening == null ? null : opening.old;
+        return close(menu);
+    }
+
+    public CompletableFuture<Void> closeAll() {
+        List<Entry> closing;
+        synchronized (lock) {
+            closing = List.copyOf(entries.values());
+            entries.clear();
+            openings.clear();
+            generation++;
+            epochs.replaceAll((playerId, epoch) -> epoch + 1);
+        }
+        CompletableFuture<?>[] closes = closing.stream()
+                .map(entry -> close(entry.handle()))
+                .toArray(CompletableFuture[]::new);
+        return CompletableFuture.allOf(closes);
+    }
+
+    public void reload(ConfigSnapshot snapshot) {
+        Objects.requireNonNull(snapshot, "snapshot");
+        if (renderer != null) {
+            renderer.resetWarnings();
+        }
+        closeAll();
+    }
+
+    private CompletableFuture<Void> close(MenuHandle menu) {
+        if (menu == null) {
+            return CompletableFuture.completedFuture(null);
+        }
+        try {
+            return adapter.closeMenu(menu);
+        } catch (RuntimeException failure) {
+            return CompletableFuture.failedFuture(failure);
+        }
+    }
+
+    private static Map<Integer, ItemStack> contents(MenuView view) {
+        Map<Integer, ItemStack> contents = new HashMap<>();
+        view.icons().forEach((slot, icon) -> contents.put(slot, icon.item()));
+        return contents;
+    }
+
+    private static Throwable unwrap(Throwable failure) {
+        return failure instanceof CompletionException && failure.getCause() != null ? failure.getCause() : failure;
+    }
+}
