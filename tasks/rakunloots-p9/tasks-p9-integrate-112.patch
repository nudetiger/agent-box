+                assertNotNull(value, language + " is missing " + key);
+                if (value instanceof List<?> list) {
+                    assertFalse(list.isEmpty(), language + " " + key);
+                    assertTrue(list.stream().anyMatch(line -> !String.valueOf(line).isBlank()), language + " " + key);
