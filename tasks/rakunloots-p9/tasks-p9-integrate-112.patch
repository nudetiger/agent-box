+        ItemMeta meta = item.getItemMeta();
+        if (meta != null && meta.getLore() != null) {
+            lore.addAll(meta.getLore());
+        }
+        boolean always = chance == null
+                ? entry.weight() < 0
+                : chance.kind() == LootChance.Kind.ALWAYS;
+        if (always) {
+            addRendered(lore, MessageText.render(snapshot, "", KEY_CONTENT_ALWAYS, Map.of()));
+        } else if (chance != null) {
+            addRendered(lore, MessageText.render(snapshot, "", KEY_CONTENT_CHANCE, Map.of(),
+                    Map.of("chance", chance.probability())));
+        } else {
+            addRendered(lore, MessageText.render(snapshot, "", KEY_CONTENT_CALCULATING, Map.of()));
+        }
+        addRendered(lore, MessageText.render(snapshot, "", KEY_CONTENT_AMOUNT,
+                Map.of("amount", Integer.toString(entry.amount()))));
+        setLore(item, lore);
+        return new MenuIcon(item, Optional.empty(), Optional.empty());
+    }
