--- a/test/calendar.test.ts
+++ b/test/calendar.test.ts
@@ -27,3 +27,13 @@ test("bad events are rejected", () => {
   assert.throws(() => cal.add({ id: "c", title: "C", date: "2026-10-15", start: "24:00", end: "10:00" }), /not a time/);
   assert.throws(() => cal.remove("zzz"), /unknown event/);
 });
+
+test("cancel and move change single occurrences", () => {
+  const cal = new Calendar();
+  cal.add({ id: "standup", title: "Standup", date: "2026-10-12", start: "09:00", end: "09:15", rule: { freq: "daily" } });
+  cal.cancel("standup", "2026-10-13");
+  cal.move("standup", "2026-10-14", { date: "2026-10-16", start: "10:00" });
+  const got = cal.occurrences("2026-10-12", "2026-10-16").map((o) => `${o.date} ${o.start} ${o.movedFrom ?? ""}`.trim());
+  assert.deepEqual(got, ["2026-10-12 540", "2026-10-15 540", "2026-10-16 540", "2026-10-16 600 2026-10-14"]);
+  assert.throws(() => cal.cancel("standup", "2026-10-01"), RangeError);
+});
